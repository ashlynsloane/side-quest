{
  "expo": {
    "name": "Side Quest",
    "slug": "side-quest",
    "version": "0.18.10",
    "orientation": "portrait",
    "icon": "./assets/images/side-quest-icon.png",
    "scheme": "sidequest",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/side-quest-icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.ashlynsloanesteam.sidequest",
      "infoPlist": {
        "NSAppTransportSecurity": {
	   "NSAllowsLocalNetworking": true,
	   "NSAllowsArbitraryLoads": true
	},
	"NSLocalNetworkUsageDescription": "Side Quest connects to the local Expo development server while the app is being developed."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8F0EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#173A2B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-asset",
      "expo-audio",
      "expo-sharing",
      "expo-video",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "a4633097-dd6d-4c0c-961a-1596e72d8c56"
      }
    }
  }
}
