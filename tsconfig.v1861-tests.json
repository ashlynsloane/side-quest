{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@circuit/domain": [
        "packages/domain/src/index.ts"
      ],
      "@circuit/generator": [
        "packages/generator/src/index.ts"
      ],
      "@circuit/exercise-content": [
        "packages/exercise-content/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/domain/src/**/*.ts",
    "packages/planner/src/**/*.ts",
    "packages/planner/test/training-intelligence.test.ts",
    "packages/generator/src/**/*.ts",
    "packages/exercise-content/src/**/*.ts",
    "v185-stubs.d.ts",
    "packages/planner/test/regional-status.test.ts"
  ],
  "exclude": [
    "packages/generator/src/demo.ts"
  ]
}
